{
  "name": "facebook-dang-bai-page",
  "title": "Đăng bài lên Fanpage",
  "group": "Facebook",
  "description": "Mở Fanpage và đăng bài. Tài khoản phải đang ở chế độ Trang (đã chuyển sang Trang) hoặc là quản trị viên.",
  "inputs": [
    {
      "name": "page_url",
      "label": "Link Fanpage",
      "type": "text",
      "required": true
    },
    {
      "name": "content",
      "label": "Nội dung bài viết",
      "type": "textarea",
      "required": true
    },
    {
      "name": "images",
      "label": "Ảnh đính kèm (đường dẫn file, mỗi dòng một ảnh)",
      "type": "file"
    },
    {
      "name": "confirm",
      "label": "Dừng lại cho tôi xem trước khi đăng",
      "type": "checkbox",
      "default": true
    }
  ],
  "steps": [
    {
      "type": "goto",
      "url": "{{inputs.page_url}}"
    },
    {
      "type": "click",
      "label": "Mở khung tạo bài",
      "selector": [
        "role=button[name=/Bạn đang nghĩ gì|What's on your mind|Tạo bài viết|Create post/i]",
        "text=/Bạn đang nghĩ gì|What's on your mind/i"
      ],
      "timeout": 20000
    },
    {
      "type": "type",
      "label": "Gõ nội dung",
      "selector": [
        "div[role=dialog] div[role=textbox][contenteditable=true]"
      ],
      "text": "{{inputs.content}}"
    },
    {
      "type": "click",
      "label": "Bấm nút Ảnh/video",
      "when": "{{inputs.images}}",
      "optional": true,
      "timeout": 5000,
      "selector": [
        "div[role=dialog] [aria-label='Ảnh/video']",
        "div[role=dialog] [aria-label='Photo/video']"
      ]
    },
    {
      "type": "upload",
      "label": "Tải ảnh lên",
      "when": "{{inputs.images}}",
      "files": "{{inputs.images}}",
      "selector": [
        "div[role=dialog] input[type=file][accept*=image]",
        "div[role=dialog] input[type=file]",
        "input[type=file][accept*=image]"
      ]
    },
    {
      "type": "sleep",
      "when": "{{inputs.images}}",
      "ms": 4000
    },
    {
      "type": "human_pause",
      "when": "{{inputs.confirm}}",
      "message": "Xem lại bài viết trong cửa sổ Chrome. Bấm Tiếp tục để đăng, hoặc Dừng để huỷ."
    },
    {
      "type": "click",
      "label": "Tiếp (nếu có)",
      "optional": true,
      "timeout": 4000,
      "selector": [
        "div[role=dialog] [role=button][aria-label='Tiếp']",
        "div[role=dialog] [role=button][aria-label='Next']"
      ]
    },
    {
      "type": "click",
      "label": "Đăng",
      "selector": [
        "div[role=dialog] [role=button][aria-label='Đăng']",
        "div[role=dialog] [role=button][aria-label='Post']"
      ]
    },
    {
      "type": "wait_for",
      "selector": "div[role=dialog] div[role=textbox][contenteditable=true]",
      "state": "hidden",
      "timeout": 60000,
      "optional": true
    },
    {
      "type": "return",
      "value": {
        "trang_thai": "Đã bấm Đăng"
      }
    }
  ]
}