{
  "name": "gemini-tao-anh",
  "title": "Tạo ảnh bằng Gemini",
  "group": "Tạo ảnh/video AI",
  "description": "Gửi mô tả tới Gemini (gemini.google.com), chờ ảnh và tải về máy.",
  "inputs": [
    {
      "name": "prompt",
      "label": "Mô tả ảnh",
      "type": "textarea",
      "required": true
    },
    {
      "name": "filename",
      "label": "Tên file",
      "type": "text",
      "default": "gemini-anh"
    }
  ],
  "steps": [
    {
      "type": "goto",
      "url": "https://gemini.google.com/app"
    },
    {
      "type": "type",
      "selector": [
        "rich-textarea div[contenteditable=true]",
        "div[role=textbox][contenteditable=true]"
      ],
      "text": "Tạo hình ảnh: {{inputs.prompt}}"
    },
    {
      "type": "press",
      "key": "Enter"
    },
    {
      "type": "wait_for",
      "label": "Chờ ảnh (có thể 1-2 phút)",
      "count_gt": {
        "selector": "generated-image img, single-image img",
        "value": 0
      },
      "timeout": 300000
    },
    {
      "type": "sleep",
      "ms": 4000
    },
    {
      "type": "download",
      "save_as": "file",
      "selector": [
        "generated-image img >> nth=-1",
        "single-image img >> nth=-1"
      ],
      "filename": "{{inputs.filename}}"
    },
    {
      "type": "return",
      "value": {
        "file": "{{vars.file}}"
      }
    }
  ]
}