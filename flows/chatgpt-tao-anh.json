{
  "name": "chatgpt-tao-anh",
  "title": "Tạo ảnh bằng ChatGPT",
  "group": "Tạo ảnh/video AI",
  "description": "Gửi mô tả tới ChatGPT (tài khoản đang đăng nhập trong profile), chờ ảnh xong và tải về máy.",
  "inputs": [
    {
      "name": "prompt",
      "label": "Mô tả ảnh",
      "type": "textarea",
      "required": true
    },
    {
      "name": "filename",
      "label": "Tên file",
      "type": "text",
      "default": "chatgpt-anh"
    }
  ],
  "steps": [
    {
      "type": "goto",
      "url": "https://chatgpt.com/"
    },
    {
      "type": "wait_for",
      "selector": "#prompt-textarea",
      "timeout": 30000
    },
    {
      "type": "type",
      "selector": "#prompt-textarea",
      "text": "Hãy tạo một hình ảnh: {{inputs.prompt}}"
    },
    {
      "type": "press",
      "key": "Enter"
    },
    {
      "type": "wait_for",
      "label": "Chờ ChatGPT bắt đầu trả lời",
      "selector": "[data-testid=stop-button]",
      "timeout": 30000,
      "optional": true
    },
    {
      "type": "wait_for",
      "label": "Chờ ảnh (có thể vài phút)",
      "count_gt": {
        "selector": "div[data-message-author-role=assistant] img, img[alt*='Generated image'], img[alt*='Hình ảnh đã tạo'], img[alt*='Ảnh đã tạo']",
        "value": 0
      },
      "timeout": 400000
    },
    {
      "type": "wait_for",
      "label": "Chờ ảnh nét hẳn",
      "selector": "[data-testid=stop-button]",
      "state": "hidden",
      "timeout": 400000
    },
    {
      "type": "sleep",
      "ms": 3000
    },
    {
      "type": "download",
      "save_as": "file",
      "selector": "div[data-message-author-role=assistant] img >> nth=-1",
      "filename": "{{inputs.filename}}"
    },
    {
      "type": "return",
      "value": {
        "file": "{{vars.file}}"
      }
    }
  ]
}